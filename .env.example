# PostgreSQL
POSTGRES_USER=wrany
POSTGRES_PASSWORD=wrany
POSTGRES_DB=wrany
POSTGRES_PORT=5432

# NATS JetStream (internal event bus; 4222 bound to 127.0.0.1 for local dev only)
NATS_URL=nats://nats:4222
NATS_STREAM=WRANY_EVENTS

# tracking-gateway
GATEWAY_PORT=8080
DATABASE_URL=postgres://wrany:wrany@localhost:5432/wrany?sslmode=disable

# JWT (tracking-gateway)
# JWT_SECRET must be set — service will not start without it
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# WebSocket tracker ingestion (tracking-gateway)
WS_MAX_MESSAGE_SIZE_BYTES=262144
WS_READ_DEADLINE_SEC=60
WS_WRITE_DEADLINE_SEC=10
WS_PING_INTERVAL_SEC=30
WS_MAX_BATCH_SIZE=100
# WS_ALLOWED_ORIGINS: comma-separated browser origins allowlist.
# Empty = only non-browser (mobile) clients allowed.
# Example: WS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com
WS_ALLOWED_ORIGINS=

# tracking-worker
WORKER_PORT=8081
# NATS consumer settings (tracking-worker)
NATS_LOCATION_SUBJECT=location.events.v1
NATS_LOCATION_CONSUMER_DURABLE=tracking-worker-location-consumer
NATS_CONSUMER_ACK_WAIT_SEC=30
NATS_CONSUMER_MAX_DELIVER=5
NATS_CONSUMER_BATCH_SIZE=100
NATS_CONSUMER_POLL_TIMEOUT_SEC=5

# Observability (profile: observability)
# Grafana runs on 3001 to avoid conflict with web app at 3000.
GRAFANA_PASSWORD=admin
POSTGRES_EXPORTER_DSN=postgresql://wrany:wrany@postgres:5432/wrany?sslmode=disable
# Local URLs:
#   Prometheus:      http://localhost:9090
#   Grafana:         http://localhost:3001
#   Loki:            http://localhost:3100
