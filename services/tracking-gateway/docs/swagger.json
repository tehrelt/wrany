{
    "swagger": "2.0",
    "info": {
        "description": "Backend API for the WR any% automatic route tracking application.\nWebSocket tracker: ws://host/v1/ws/tracker — see docs/contracts/websocket-tracker-protocol.md",
        "title": "WR any% API",
        "contact": {},
        "version": "0.1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/healthz": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swHealthzEnv"
                        }
                    }
                }
            }
        },
        "/v1/auth/login": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Login",
                "parameters": [
                    {
                        "description": "Login credentials",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swLoginReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swTokenPairEnv"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swErr"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swErr"
                        }
                    }
                }
            }
        },
        "/v1/auth/refresh": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Refresh access token",
                "parameters": [
                    {
                        "description": "Refresh token",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swRefreshReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swTokenPairEnv"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swErr"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swErr"
                        }
                    }
                }
            }
        },
        "/v1/auth/register": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Register a new user",
                "parameters": [
                    {
                        "description": "Registration credentials",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swRegisterReq"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swTokenPairEnv"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swErr"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swErr"
                        }
                    },
                    "422": {
                        "description": "Unprocessable Entity",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swErr"
                        }
                    }
                }
            }
        },
        "/v1/devices": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "devices"
                ],
                "summary": "List current user's devices",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swDevicesEnv"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swErr"
                        }
                    }
                }
            }
        },
        "/v1/devices/register": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "devices"
                ],
                "summary": "Register a device",
                "parameters": [
                    {
                        "description": "Device registration",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swRegisterDeviceReq"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swDeviceEnv"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swErr"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swErr"
                        }
                    },
                    "422": {
                        "description": "Unprocessable Entity",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swErr"
                        }
                    }
                }
            }
        },
        "/v1/me": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Get current user",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swMeEnv"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swErr"
                        }
                    }
                }
            }
        },
        "/v1/tracking/points": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tracking"
                ],
                "summary": "List raw GPS points for the authenticated user",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filter by device UUID",
                        "name": "device_id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Start of time range (RFC3339)",
                        "name": "from",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "End of time range (RFC3339)",
                        "name": "to",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Max results per page (default 1000, max 5000)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Pagination cursor from previous response",
                        "name": "cursor",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swTrackingPointsEnv"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swErr"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swErr"
                        }
                    }
                }
            }
        },
        "/v1/tracking/summary": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tracking"
                ],
                "summary": "Get aggregated stats for a time range",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filter by device UUID",
                        "name": "device_id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Start of time range (RFC3339)",
                        "name": "from",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "End of time range (RFC3339)",
                        "name": "to",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swTrackingSummaryEnv"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swErr"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/internal_transport_http.swErr"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "internal_transport_http.swDevice": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "device_id": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "last_seen_at": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "platform": {
                    "type": "string"
                }
            }
        },
        "internal_transport_http.swDeviceEnv": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/internal_transport_http.swDevice"
                },
                "error": {
                    "type": "string"
                }
            }
        },
        "internal_transport_http.swDevicesEnv": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/internal_transport_http.swDevice"
                    }
                },
                "error": {
                    "type": "string"
                }
            }
        },
        "internal_transport_http.swErr": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "string"
                },
                "error": {
                    "type": "string",
                    "example": "unauthorized"
                }
            }
        },
        "internal_transport_http.swHealthz": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "internal_transport_http.swHealthzEnv": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/internal_transport_http.swHealthz"
                },
                "error": {
                    "type": "string"
                }
            }
        },
        "internal_transport_http.swLoginReq": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "internal_transport_http.swMe": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                }
            }
        },
        "internal_transport_http.swMeEnv": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/internal_transport_http.swMe"
                },
                "error": {
                    "type": "string"
                }
            }
        },
        "internal_transport_http.swRefreshReq": {
            "type": "object",
            "properties": {
                "refresh_token": {
                    "type": "string"
                }
            }
        },
        "internal_transport_http.swRegisterDeviceReq": {
            "type": "object",
            "properties": {
                "device_id": {
                    "type": "string",
                    "example": "b0d34c19-ef5e-4e35-bd30-1d6680245c10"
                },
                "name": {
                    "type": "string",
                    "example": "Pixel 8"
                },
                "platform": {
                    "type": "string",
                    "example": "android"
                }
            }
        },
        "internal_transport_http.swRegisterReq": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "example": "rider@example.com"
                },
                "password": {
                    "type": "string",
                    "example": "hunter2"
                }
            }
        },
        "internal_transport_http.swTokenPair": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
                },
                "refresh_token": {
                    "type": "string"
                }
            }
        },
        "internal_transport_http.swTokenPairEnv": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/internal_transport_http.swTokenPair"
                },
                "error": {
                    "type": "string"
                }
            }
        },
        "internal_transport_http.swTrackingPoint": {
            "type": "object",
            "properties": {
                "accuracy_m": {
                    "type": "number",
                    "example": 8.5
                },
                "activity_type": {
                    "type": "string",
                    "example": "walking"
                },
                "bearing_deg": {
                    "type": "number"
                },
                "device_id": {
                    "type": "string"
                },
                "event_id": {
                    "type": "string"
                },
                "lat": {
                    "type": "number",
                    "example": 55.751244
                },
                "lon": {
                    "type": "number",
                    "example": 37.618423
                },
                "recorded_at": {
                    "type": "string",
                    "example": "2026-06-10T12:00:01Z"
                },
                "speed_mps": {
                    "type": "number"
                }
            }
        },
        "internal_transport_http.swTrackingPointsEnv": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/internal_transport_http.swTrackingPointsResponse"
                },
                "error": {
                    "type": "string"
                }
            }
        },
        "internal_transport_http.swTrackingPointsResponse": {
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/internal_transport_http.swTrackingPoint"
                    }
                },
                "next_cursor": {
                    "type": "string"
                }
            }
        },
        "internal_transport_http.swTrackingSummary": {
            "type": "object",
            "properties": {
                "avg_speed_mps": {
                    "type": "number"
                },
                "duration_sec": {
                    "type": "integer",
                    "example": 1800
                },
                "first_recorded_at": {
                    "type": "string",
                    "example": "2026-06-10T12:00:01Z"
                },
                "last_recorded_at": {
                    "type": "string",
                    "example": "2026-06-10T12:30:01Z"
                },
                "max_speed_mps": {
                    "type": "number"
                },
                "points_count": {
                    "type": "integer",
                    "example": 123
                }
            }
        },
        "internal_transport_http.swTrackingSummaryEnv": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/internal_transport_http.swTrackingSummary"
                },
                "error": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Bearer JWT access token. For WebSocket upgrade ?access_token=\u003cjwt\u003e is also accepted.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}