VITE_API_BASE_URL=http://localhost:8080
# Map tile provider. Leave empty to use OSM raster fallback (dev only).
# For production use a dedicated provider or self-hosted tiles.
VITE_MAP_STYLE_URL=
# Yandex Maps JavaScript API v3 key.
# Enable JS API v3 and allow your localhost/production domains.
# Auto fallback chain: Yandex v3 -> Yandex v2.1 -> OSM.
VITE_YANDEX_MAPS_API_KEY=
